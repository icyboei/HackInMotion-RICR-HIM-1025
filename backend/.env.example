# MedSafe Backend — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file.

# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority&appName=ClusterName

# ─── Authentication ───────────────────────────────────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_strong_random_jwt_secret_here

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
FRONTEND_URL=http://localhost:5173

# ─── AI Assistant (optional) ─────────────────────────────────────────────────
# Get a free Gemini API key from: https://makersuite.google.com/app/apikey
# If not set, the AI assistant will return a helpful stub response.
GEMINI_API_KEY=your_gemini_api_key_here
